NAME=news.dev API
TYPE=site
ID=appnewsai
MAIN=app.jar
VERSION=latest
RAM=1024
AUTORESTART=true
START=java -XX:MaxRAMPercentage=65 -jar app.jar --server.address=0.0.0.0 --server.port=8080 --radar.ingestion.enabled=true --radar.ingestion.tech-feeds-enabled=true --radar.ingestion.google-news.enabled=true --spring.config.import=optional:file:./.env[.properties]
