# Supabase Dashboard > Connect > Session pooler (IPv4), ou Direct (IPv6).
# Senha separada evita problemas com caracteres especiais na URL.
SUPABASE_DB_URL=jdbc:postgresql://SEU_HOST:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.SEU_PROJECT_REF
SUPABASE_DB_PASSWORD=
DB_POOL_SIZE=5
DB_MIGRATIONS_ENABLED=true
# Login Google: URL e chave PUBLICAVEL/anon; nunca service_role no aplicativo.
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
PUSH_WEBHOOK_URL=
PUSH_WEBHOOK_SECRET=
# Gere 48 bytes aleatórios e codifique em Base64.
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:3000
API_DOCS_ENABLED=true
DELIVERY_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=radar@example.com
PASSWORD_RESET_URL=radar://recuperar-senha
INGESTION_ENABLED=false
TECH_FEEDS_ENABLED=false
TECH_LICENSED_FEEDS_ENABLED=false
INGESTION_DELAY_MS=900000
RSS_ALLOWED_HOSTS=
# Busca de notícias por tópico no Google News (sem chave de API).
# Texto completo só é guardado nos FULLTEXT_HOSTS; nos demais sites, sinopse e link.
GOOGLE_NEWS_ENABLED=false
GOOGLE_NEWS_DELAY_MS=1800000
GOOGLE_NEWS_PER_TOPIC=8
# Veiculos buscados no Google News; fora dos FULLTEXT_HOSTS guarda so sinopse e link.
GOOGLE_NEWS_SITES=g1.globo.com,agenciabrasil.ebc.com.br,cnnbrasil.com.br,r7.com,band.com.br,sbt.com.br,tvcultura.com.br
GOOGLE_NEWS_FULLTEXT_HOSTS=agenciabrasil.ebc.com.br

GEMINI_API_KEY=
